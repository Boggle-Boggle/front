{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Path config */
    "paths": {
      "api.types": ["./src/api.types.ts"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "icons/*": ["./src/components/icons/*"],
      "hooks/*": ["./src/hooks/*"],
      "pages/*": ["./src/pages/*"],
      "services/*": ["./src/services/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"],
      "stores/*": ["./src/stores/*"],
      "constants/*": ["./src/constants/*"],
      "routes/*": ["./src/routes/*"]
    },
    /* Linting */
    "strict": true
  },
  "include": ["src"],
  // TODO: 레거시 코드 제거예정
  "exclude": [
    "node_modules",
    "src/pages/legacy/**/*",
    "src/services/legacy/**/*",
    "src/hooks/useNickNameInput.ts",
    "src/stories/**/*"
  ]
}
